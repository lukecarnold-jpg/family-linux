[Unit]
Description=Family Linux: apply the policy once after the first boot
# The installer creates the accounts; systemd-resolved must be running for the DNS filter to apply.
After=network-online.target systemd-resolved.service
Wants=network-online.target
ConditionPathExists=!/var/lib/family-linux/firstboot.done
StartLimitIntervalSec=0

[Service]
Type=oneshot
Environment=PYTHONPATH=/opt/family-linux/src
ExecStart=/usr/bin/python3 -m family_linux.provisioner.firstboot
# Also on the console, so a headless build can see when the first boot has finished.
StandardOutput=journal+console
StandardError=journal+console
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
