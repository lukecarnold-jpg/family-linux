[Unit]
Description=Family Linux Screen Time and Policy Enforcement Daemon
After=network.target systemd-logind.service
Wants=systemd-logind.service

[Service]
Type=simple
ExecStart=/usr/local/bin/family-policyd --interval 60
Restart=always
RestartSec=10
User=root
Group=root

# Hardening
ProtectSystem=full
ProtectHome=read-only
ReadOnlyPaths=/etc/family-linux

[Install]
WantedBy=multi-user.target
